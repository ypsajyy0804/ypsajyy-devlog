# ---- 编译产物 ----
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.out
a.out
*.gcda
*.gcno
*.dSYM/

# ---- MSVC / Visual Studio 的中间文件 ----
# (.pdb 单个就有 7MB，.ilk 3MB —— 绝对不能进公开仓库)
*.ilk
*.pdb
*.idb
*.exp
*.lib
*.suo
*.sdf
*.opendb
*.VC.db
*.recipe


# ---- 构建目录 ----
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
Makefile.in

# ---- Go ----
*.test
*.prof

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 环境变量与密钥：绝对不要提交 ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
credentials*

# ---- 临时文件 ----
*.tmp
*.bak
*.log
!journal/*.md

# ---- Office 打开文件时生成的锁文件 ----
# 用 Word 打开 daily/*.docx 就会冒出 ~$xxxx.docx，里面是用户名，别提交
~$*
